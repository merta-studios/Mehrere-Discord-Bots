# ============================================================
#  Multi-Bot-Hoster – Umgebungsvariablen
#  Kopiere diese Datei zu ".env" und fülle die Werte aus.
#  Auf Render trägst du dieselben Variablen im Dashboard ein.
# ============================================================

# Port für den Health-Server (Render vergibt automatisch einen).
# UptimeRobot pinguft diesen Endpunkt, damit der kostenlose
# Render-Server nicht nach 15 Minuten in den Schlafmodus fällt.
PORT=10000

# ------------------------------------------------------------
# Geburtstags-Bot
# ------------------------------------------------------------

# Token des Geburtstags-Bots (aus dem Discord Developer Portal)
BIRTHDAY_BOT_TOKEN=

# Discord-ID des Bot-Owners – HIER eintragen!
# Der Owner erreicht damit das /adminpanel im Privatchat.
BIRTHDAY_BOT_OWNER_ID=1414615828342509628

# OPTIONAL: Nur für die Entwicklung – registriert die Slash-Commands
# sofort in dieser einen Gilde (statt global, dauert sonst bis zu 1h).
# Im Produktivbetrieb einfach leer lassen.
BIRTHDAY_BOT_GUILD_ID=

# OPTIONAL: Zeitzonen-Override pro Sprache.
# Standardwerte: de=Europe/Berlin, en=America/New_York, fr=Europe/Paris,
# es=Europe/Madrid, pt=America/Sao_Paulo, ru=Europe/Moscow,
# ja=Asia/Tokyo, ko=Asia/Seoul, zh=Asia/Shanghai, it=Europe/Rome
# BIRTHDAY_BOT_TZ_EN=Europe/London

# ------------------------------------------------------------
# XP-Level-Bot – RAM-first, Turso-persistiert
# ------------------------------------------------------------

# Token des XP-Bots (eigene Discord App!)
XP_BOT_TOKEN=

# Owner für XP Bot (falls leer, wird BIRTHDAY_BOT_OWNER_ID genommen)
XP_BOT_OWNER_ID=

# Dev-Gilde für sofortige Command-Registrierung (optional)
XP_BOT_GUILD_ID=

# Turso Datenbank (nur für den XP-Bot) – https://turso.tech
# 1) Auf https://app.turso.tech → Database erstellen (z.B. xp-level-bot-db)
# 2) `turso db show <name> --url` → URL kopieren
# 3) `turso db tokens create <name>` → Token kopieren
# Lokal: npx turso dev geht auch, dann URL = libsql://... oder file:./xp.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: Turso nur für XP Bot getrennt (überschreibt obige falls gesetzt)
# XP_TURSO_DATABASE_URL=
# XP_TURSO_AUTH_TOKEN=

# OPTIONAL: Zeitzonen-Override für XP Bot pro Sprache (wie oben, aber mit XP_BOT_)
# XP_BOT_TZ_DE=Europe/Berlin
# XP_BOT_TZ_EN=America/New_York

# ------------------------------------------------------------
# Self-Roles-Bot 🎭 – Rollen zum Selbstbedienen, OHNE Datenbank
# (speichert alles unsichtbar in der Nachricht selbst – wie der
#  Geburtstags-Bot. Es wird KEINE Datenbank benötigt!)
# ------------------------------------------------------------

# Token des Self-Roles-Bots (eigene Discord App!)
SELF_ROLES_BOT_TOKEN=

# Owner für das /adminpanel (falls leer, wird BIRTHDAY_BOT_OWNER_ID genommen)
SELF_ROLES_BOT_OWNER_ID=

# Dev-Gilde für sofortige Command-Registrierung (optional)
SELF_ROLES_BOT_GUILD_ID=
